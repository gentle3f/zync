    "generate-reference-free-v1": "node src/generateCompiledBatch.js --model=text --only=crafts.diy,lifestyle.game_nights,fashion.streetwear,technology.ai",
    "audit-model-ab-v1-gemini": "node src/generateCompiledBatch.js --dry-run --model=geminiText --only=lifestyle.game_nights,fashion.streetwear",
    "audit-model-ab-v1-klein": "node src/generateCompiledBatch.js --dry-run --model=kleinNegative --only=lifestyle.game_nights,fashion.streetwear",
    "generate-model-ab-v1-gemini": "node src/generateCompiledBatch.js --model=geminiText --only=lifestyle.game_nights,fashion.streetwear",
    "generate-model-ab-v1-klein": "node src/generateCompiledBatch.js --model=kleinNegative --only=lifestyle.game_nights,fashion.streetwear",
