{
  "name": "zync-card-art-pilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone fal.ai artwork generation pilot for Zync Hobby Cards. Not part of the main app runtime.",
  "scripts": {
    "generate": "node src/generate.js",
